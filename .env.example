# ============================================================
# CivicPulse AI - Environment Variables
# Copy this file to .env and adjust values as needed.
# NEVER commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# Backend Configuration (Render Web Service / Local)
# ----------------------------------------------------------

# Port (dynamically assigned by Render in production, defaults to 8000 locally)
PORT=8000

# SQLite database URL
# For local development (relative to backend/):
DATABASE_URL=sqlite:///./data/civicpulse.db

# For Docker deployment (absolute path inside container):
# DATABASE_URL=sqlite:////app/data/civicpulse.db

# Application environment: development | production
ENVIRONMENT=development

# Enable SQLAlchemy query logging (disable in production)
DEBUG=false

# CORS allowed origins (comma-separated list)
# Add all frontend origins that should be allowed to call the API
# Production: Add your Vercel frontend URL, e.g.:
# BACKEND_CORS_ORIGINS=https://civicpulse.vercel.app,http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Academic / Competition Demo Reset Flag
# Set to 1 or true in production (Render) to enable evaluator demo state reset via UI navbar
ALLOW_PROD_RESET=1

# ----------------------------------------------------------
# Frontend Configuration (Vercel / Local - used at build time via Vite)
# ----------------------------------------------------------

# Backend API base URL visible from the browser
# Local dev: leave empty or defaults to "/api/v1" via Vite proxy
# Production (Vercel): Set to your public Render backend API URL, e.g.:
# VITE_API_BASE_URL=https://civicpulse-api.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1
